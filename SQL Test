Question 4 
SELECT
ROUND((COUNTIF(vhsyn_vf_g2016_synthetic in ('A','E','Y'))/COUNT(*))*100,2) as Voted_percent
,ROUND((COUNTIF(vhsyn_vf_g2016_synthetic in ('N','I'))/COUNT(*))*100,2) as Didnt_vote_percent
